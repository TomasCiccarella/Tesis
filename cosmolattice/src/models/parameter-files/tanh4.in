#Output
outputfile = ./data/test/

#Evolution
expansion = true
evolver = VV2

#Lattice
N = 32
dt = 0.01
kIR = 0.75

#Times
tOutputFreq = 0.1
tOutputInfreq = 3
tOutputRareFreq = 10
tMax = 900

#IC
kCutOff = 100
initial_amplitudes = 6.5645e18 0 # homogeneous amplitudes in GeV
initial_momenta = -2.07694e31 0    # homogeneous amplitudes in GeV2

#Model Parameters
M = 2.435e19
Lambda4 = 1.7966e65
q = 4e4

#GWs
GWprojectorType = 1
withGWs=true
OccNumb = true
