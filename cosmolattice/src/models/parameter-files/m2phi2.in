#Output
outputfile = ./data/varm/m2.435e15/

#Evolution
expansion = true
evolver = VV2

#Lattice
N = 32
dt = 0.01
kIR = 3

#Times
tOutputFreq = 0.1
tOutputInfreq = 3
tOutputRareFreq = 10
tMax = 900
baseSeed = 4356597

#Spectra options
PS_type = 1
PS_version = 1

#GWs
GWprojectorType = 1
withGWs = true
OccNumb = true

#IC
kCutOff = 18
initial_amplitudes = 3.44e18 0  # homogeneous amplitudes in GeV
initial_momenta = -2.90e31 0 # homogeneous amplitudes in GeV2

#Model Parameters
m = 2.435e15
q = 16000
