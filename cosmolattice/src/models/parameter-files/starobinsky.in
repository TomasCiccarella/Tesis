#Output
outputfile = ./data/prueba/

#Evolution
expansion = true
evolver = VV2

#Lattice
N = 64
dt = 0.01
kIR = 0.75

#Times
tOutputFreq = 0.1
tOutputInfreq = 10
tMax = 100

#Spectra options
PS_type = 1
PS_version = 1
projectorType = 1

#GWs
GWprojectorType = 1
withGWs = true

#IC
kCutOff = 100
initial_amplitudes = 7.42675e18 0 # homogeneous amplitudes in GeV
initial_momenta = -6.2969e30 0 # homogeneous amplitudes in GeV2

#Model Parameters
kappa = 1e-10
gamma = 1.0
q = 1e-8
