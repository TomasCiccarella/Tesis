#Output
outputfile = ./data/

#Evolution
expansion = true
evolver = VV2

#Lattice
N = 32
dt = 0.01
kIR = 0.75

#Times
tOutputFreq = 0.5
tOutputInfreq = 20
tMax = 200

#Spectra options
PS_type = 1
PS_version = 1
projectorType = 1

#GWs
GWprojectorType = 1
withGWs = true
OccNumb = true

#IC
kCutOff = 100
initial_amplitudes = 0.731 0.0
initial_momenta = -0.337 0.0

#Model Parameters
kappa = 1e-6
g = 4e-5
