#Output
outputfile = ./data/prueba/

#Evolution
expansion = true
evolver = VV2

#Lattice
N = 64
dt = 0.001
kIR = 0.75

#Times
tOutputFreq = 0.1
tOutputInfreq = 10
tMax = 100

#Spectra options
PS_type = 1
PS_version = 1
projectorType = 1

#GWs
GWprojectorType = 1
withGWs = true

#IC
kCutOff = 100
initial_amplitudes_GeV = 1.78e18 0
initial_momenta_GeV2 = -3.769e34 0

#Model Parameters
kappa = 1e-6
q = 1e-6
