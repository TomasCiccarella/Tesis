#Output
outputfile = ./data/DEF/

#Evolution
expansion = true
evolver = VV2

#Lattice
N = 32
dt = 0.01
kIR = 3

#Times
tOutputFreq = 0.1
tOutputInfreq = 3
tOutputRareFreq = 10
tMax = 900

#IC
kCutOff = 18
initial_amplitudes = 3.22088e18 0 # homogeneous amplitudes in GeV
initial_momenta = -5.25164e31 0    # homogeneous amplitudes in GeV2

#Model Parameters
M = 2.903e19
Lambda4 = 1.7966e65
q = 4490

#GWs
GWprojectorType = 1
withGWs=true
OccNumb = true
