#Output
outputfile = ./data/def/

#Evolution
expansion = true
evolver = VV2

#Lattice
N = 128
dt = 0.003
kIR = 3

#Times
tOutputFreq = 0.1
tOutputInfreq = 3
tOutputRareFreq = 10
tMax = 100

#IC
kCutOff = 18
initial_amplitudes = 3.22088e18 0 # homogeneous amplitudes in GeV
initial_momenta = -5.25164e31 0    # homogeneous amplitudes in GeV2

#Model Parameters
M = 2.435e19
Lambda4 = 1.7966e65
q = 4e4

#GWs
GWprojectorType = 1
withGWs=true
OccNumb = true
