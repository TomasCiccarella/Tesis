\newlabel{fig:CosmoLattice_energy_analysis_w0}{{4.13}{61}{Análisis de los tiempos característicos de producción de ondas gravitacionales para modelos de tipo materia. Se demarcan los instantes de inicio de la amplificación resonante y de saturación asintótica para establecer el intervalo efectivo de inyección de energía tensorial}{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.14}{\ignorespaces Espectro de potencias de las ondas gravitacionales proyectado a la actualidad para los modelos de tipo materia. Se aprecia una notable equivalencia morfológica y de amplitud entre los tres potenciales a escalas intermedias y ultravioletas. Las divergencias ruidosas en los modos infrarrojos constituyen artefactos numéricos de red originados por el volumen finito de la simulación.}}{62}{figure.caption.29}\protected@file@percent }
\newlabel{fig:CosmoLattice_GW_spectra_w0}{{4.14}{62}{Espectro de potencias de las ondas gravitacionales proyectado a la actualidad para los modelos de tipo materia. Se aprecia una notable equivalencia morfológica y de amplitud entre los tres potenciales a escalas intermedias y ultravioletas. Las divergencias ruidosas en los modos infrarrojos constituyen artefactos numéricos de red originados por el volumen finito de la simulación}{figure.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.15}{\ignorespaces Espectro de ondas gravitacionales para el modelo $m^2 \phi ^2$ variando el parámetro de acoplamiento $q$. Se ilustra la transición hacia el régimen de resonancia ancha para $q \gtrsim 7280$, umbral a partir del cual el espectro adquiere amplitudes macroscópicas y picos bien definidos.}}{63}{figure.caption.30}\protected@file@percent }
\newlabel{fig:Omega_varq_m2phi2}{{4.15}{63}{Espectro de ondas gravitacionales para el modelo $m^2 \phi ^2$ variando el parámetro de acoplamiento $q$. Se ilustra la transición hacia el régimen de resonancia ancha para $q \gtrsim 7280$, umbral a partir del cual el espectro adquiere amplitudes macroscópicas y picos bien definidos}{figure.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.16}{\ignorespaces Evolución de la densidad de energía gravitacional para distintos valores de $q$ en el modelo monomial. A bajos acoplamientos, la inyección de energía es exigua, requiriendo un $q$ elevado para desatar una cascada resonante eficiente.}}{63}{figure.caption.31}\protected@file@percent }
\newlabel{fig:energy_varq_m2phi2}{{4.16}{63}{Evolución de la densidad de energía gravitacional para distintos valores de $q$ en el modelo monomial. A bajos acoplamientos, la inyección de energía es exigua, requiriendo un $q$ elevado para desatar una cascada resonante eficiente}{figure.caption.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.17}{\ignorespaces Espectro de potencias para el modelo $m^2 \phi ^2$ ante variaciones de la masa $m$. Masas más elevadas suprimen la amplitud espectral debido a una transferencia de energía acelerada que acorta la ventana de eficiencia resonante.}}{64}{figure.caption.32}\protected@file@percent }
\newlabel{fig:Omega_varm_m2phi2}{{4.17}{64}{Espectro de potencias para el modelo $m^2 \phi ^2$ ante variaciones de la masa $m$. Masas más elevadas suprimen la amplitud espectral debido a una transferencia de energía acelerada que acorta la ventana de eficiencia resonante}{figure.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.18}{\ignorespaces Evolución energética para distintas masas en el modelo $m^2 \phi ^2$. Se observa cómo el incremento de la masa altera la tasa de transferencia de energía del \textit  {background} hacia los gradientes del campo hijo.}}{65}{figure.caption.33}\protected@file@percent }
\newlabel{fig:energy_varm_m2phi2}{{4.18}{65}{Evolución energética para distintas masas en el modelo $m^2 \phi ^2$. Se observa cómo el incremento de la masa altera la tasa de transferencia de energía del \textit {background} hacia los gradientes del campo hijo}{figure.caption.33}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.19}{\ignorespaces Espectro de ondas gravitacionales evaluado para distintos anchos de la meseta (parametrizados por $M$) conservando la masa efectiva $m$ constante. Mayores valores de $M$ trasladan la potencia hacia modos ultravioletas y deprimen la señal estocástica total.}}{65}{figure.caption.34}\protected@file@percent }
\newlabel{fig:Omega_varM}{{4.19}{65}{Espectro de ondas gravitacionales evaluado para distintos anchos de la meseta (parametrizados por $M$) conservando la masa efectiva $m$ constante. Mayores valores de $M$ trasladan la potencia hacia modos ultravioletas y deprimen la señal estocástica total}{figure.caption.34}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.20}{\ignorespaces Evolución energética frente a la variación de la escala $M$ para los modelos con meseta. Se evidencia la dependencia temporal de la transferencia de energía y la saturación de los gradientes espaciales en función de la topología del potencial.}}{66}{figure.caption.35}\protected@file@percent }
\newlabel{fig:energy_varM}{{4.20}{66}{Evolución energética frente a la variación de la escala $M$ para los modelos con meseta. Se evidencia la dependencia temporal de la transferencia de energía y la saturación de los gradientes espaciales en función de la topología del potencial}{figure.caption.35}{}}
