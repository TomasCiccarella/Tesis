\newlabel{sec:comparaciones_w1/3}{{4.5}{57}{Comparación de espectros con \texorpdfstring {$\omega _{eff} = 1/3$}{omega = 1/3}}{section.4.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.7}{\ignorespaces Evolución temporal de las distintas componentes de la densidad de energía para los campos de materia. En la figura se comparan los modelos de tipo radiación, evidenciando cómo la producción de ondas gravitacionales se encuentra estrictamente ligada a la amplificación de los gradientes de los campos y de la energía de interacción.}}{57}{figure.caption.22}\protected@file@percent }
\newlabel{fig:CosmoLattice_energies_w1/3}{{4.7}{57}{Evolución temporal de las distintas componentes de la densidad de energía para los campos de materia. En la figura se comparan los modelos de tipo radiación, evidenciando cómo la producción de ondas gravitacionales se encuentra estrictamente ligada a la amplificación de los gradientes de los campos y de la energía de interacción}{figure.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.8}{\ignorespaces Análisis de tiempos característicos para la producción de ondas gravitacionales en modelos de tipo radiación. Se identificaron los instantes de inicio de amplificación y de posterior saturación de la densidad de energía, definiendo así el intervalo temporal efectivo de producción. Se observa que el modelo $\tanh ^4$ mantiene activa la generación de ondas durante un período mayor que el modelo monomial.}}{58}{figure.caption.23}\protected@file@percent }
\newlabel{fig:CosmoLattice_energy_analysis_w1/3}{{4.8}{58}{Análisis de tiempos característicos para la producción de ondas gravitacionales en modelos de tipo radiación. Se identificaron los instantes de inicio de amplificación y de posterior saturación de la densidad de energía, definiendo así el intervalo temporal efectivo de producción. Se observa que el modelo $\tanh ^4$ mantiene activa la generación de ondas durante un período mayor que el modelo monomial}{figure.caption.23}{}}
\citation{Ellis_2026}
\@writefile{lof}{\contentsline {figure}{\numberline {4.9}{\ignorespaces Espectro de potencia de las ondas gravitacionales, reescalado desde la salida numérica de \ensuremath  {\mathcal  {C}}\text  {osmo}\ensuremath  {\mathcal  {L}}\text  {attice}\xspace  hasta las magnitudes observables en la actualidad. Se aprecia que el modelo $\lambda \phi ^4$ presenta una estructura de picos más aguda y una amplitud levemente mayor que la del modelo $\tanh ^4$, aunque ambos comparten el mismo orden de magnitud global.}}{59}{figure.caption.24}\protected@file@percent }
\newlabel{fig:CosmoLattice_GW_spectra_w1/3}{{4.9}{59}{Espectro de potencia de las ondas gravitacionales, reescalado desde la salida numérica de \CosmoLattice hasta las magnitudes observables en la actualidad. Se aprecia que el modelo $\lambda \phi ^4$ presenta una estructura de picos más aguda y una amplitud levemente mayor que la del modelo $\tanh ^4$, aunque ambos comparten el mismo orden de magnitud global}{figure.caption.24}{}}
\citation{Figueroa_2017_Parametric}
\@writefile{lof}{\contentsline {figure}{\numberline {4.10}{\ignorespaces Espectros de potencia para el modelo $\lambda \phi ^4$ evaluados bajo distintos valores de la constante $\lambda $. Reducciones en $\lambda $ derivan en un mayor número de picos armónicos pero suprimen la amplitud total de energía. Asimismo, se evidencia que mayores valores de $\lambda $ desplazan los picos de máxima emisión hacia frecuencias mayores ($k$).}}{60}{figure.caption.25}\protected@file@percent }
\newlabel{fig:var_lambda}{{4.10}{60}{Espectros de potencia para el modelo $\lambda \phi ^4$ evaluados bajo distintos valores de la constante $\lambda $. Reducciones en $\lambda $ derivan en un mayor número de picos armónicos pero suprimen la amplitud total de energía. Asimismo, se evidencia que mayores valores de $\lambda $ desplazan los picos de máxima emisión hacia frecuencias mayores ($k$)}{figure.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.11}{\ignorespaces Espectros de potencia para el modelo $\tanh ^4$ variando $\Lambda ^4$ y $M$ bajo la restricción $\displaystyle \lambda = \frac  {\Lambda ^4}{M^4} = 9 \times 10^{-14}$. El incremento en la escala de energía $\Lambda ^4$ induce un aumento simultáneo tanto en la amplitud del espectro como en la frecuencia de los picos resonantes.}}{61}{figure.caption.26}\protected@file@percent }
\newlabel{fig:var_tanh4}{{4.11}{61}{Espectros de potencia para el modelo $\tanh ^4$ variando $\Lambda ^4$ y $M$ bajo la restricción $\displaystyle \lambda = \frac {\Lambda ^4}{M^4} = 9 \times 10^{-14}$. El incremento en la escala de energía $\Lambda ^4$ induce un aumento simultáneo tanto en la amplitud del espectro como en la frecuencia de los picos resonantes}{figure.caption.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.12}{\ignorespaces Evolución temporal de la transferencia de energía para distintos valores del parámetro de acoplamiento $q$ en el modelo cuártico. Se puede observar que el aumento en $q$ genera un inicio más temprano en la producción de ondas gravitacionales, un aumento en su energía y una producción más corta.}}{62}{figure.caption.27}\protected@file@percent }
\newlabel{fig:energy_lphi4_varq}{{4.12}{62}{Evolución temporal de la transferencia de energía para distintos valores del parámetro de acoplamiento $q$ en el modelo cuártico. Se puede observar que el aumento en $q$ genera un inicio más temprano en la producción de ondas gravitacionales, un aumento en su energía y una producción más corta}{figure.caption.27}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.13}{\ignorespaces Espectro de densidad de ondas gravitacionales en función de la variación del parámetro $q$. Se puede observar que el aumento en $q$ genera que lis picos resonantes se agudicen y aumenten su amplitud pero no se observa cambio en la frecuencia de estos.}}{62}{figure.caption.28}\protected@file@percent }
\newlabel{fig:Omega_lphi4_varq}{{4.13}{62}{Espectro de densidad de ondas gravitacionales en función de la variación del parámetro $q$. Se puede observar que el aumento en $q$ genera que lis picos resonantes se agudicen y aumenten su amplitud pero no se observa cambio en la frecuencia de estos}{figure.caption.28}{}}
