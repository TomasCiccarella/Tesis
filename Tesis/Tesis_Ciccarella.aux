\@writefile{lof}{\contentsline {figure}{\numberline {4.6}{\ignorespaces Evolución dinámica del inflatón $\phi $ para modelos con (a) $\omega _{eff} = 1/3$ y (b) $\omega _{eff} = 0$. Se evidencia que los potenciales monomiales inducen un decaimiento más rápido de la amplitud del campo \textit  {background} en comparación con los modelos de tipo \textit  {plateau}.}}{55}{figure.caption.21}\protected@file@percent }
\newlabel{fig:CosmoLattice_background_phi}{{4.6}{55}{Evolución dinámica del inflatón $\phi $ para modelos con (a) $\omega _{eff} = 1/3$ y (b) $\omega _{eff} = 0$. Se evidencia que los potenciales monomiales inducen un decaimiento más rápido de la amplitud del campo \textit {background} en comparación con los modelos de tipo \textit {plateau}}{figure.caption.21}{}}
