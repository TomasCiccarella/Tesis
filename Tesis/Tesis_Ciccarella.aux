\@writefile{lof}{\contentsline {figure}{\numberline {4.9}{\ignorespaces Espectro de potencia de las ondas gravitacionales, reescalado desde la salida numérica de \ensuremath  {\mathcal  {C}}\text  {osmo}\ensuremath  {\mathcal  {L}}\text  {attice}\xspace  hasta las magnitudes observables en la actualidad. Se aprecia que el modelo $\lambda \phi ^4$ presenta una estructura de picos más aguda y una amplitud levemente mayor que la del modelo $\tanh ^4$, aunque ambos comparten el mismo orden de magnitud global.}}{58}{figure.caption.24}\protected@file@percent }
\newlabel{fig:CosmoLattice_GW_spectra_w1/3}{{4.9}{58}{Espectro de potencia de las ondas gravitacionales, reescalado desde la salida numérica de \CosmoLattice hasta las magnitudes observables en la actualidad. Se aprecia que el modelo $\lambda \phi ^4$ presenta una estructura de picos más aguda y una amplitud levemente mayor que la del modelo $\tanh ^4$, aunque ambos comparten el mismo orden de magnitud global}{figure.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.10}{\ignorespaces Espectros de potencia para el modelo $\lambda \phi ^4$ evaluados bajo distintos valores de la constante $\lambda $. Reducciones en $\lambda $ derivan en un mayor número de picos armónicos pero suprimen la amplitud total de energía. Asimismo, se evidencia que mayores valores de $\lambda $ desplazan los picos de máxima emisión hacia frecuencias mayores ($k$).}}{59}{figure.caption.25}\protected@file@percent }
\newlabel{fig:var_lambda}{{4.10}{59}{Espectros de potencia para el modelo $\lambda \phi ^4$ evaluados bajo distintos valores de la constante $\lambda $. Reducciones en $\lambda $ derivan en un mayor número de picos armónicos pero suprimen la amplitud total de energía. Asimismo, se evidencia que mayores valores de $\lambda $ desplazan los picos de máxima emisión hacia frecuencias mayores ($k$)}{figure.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.11}{\ignorespaces Espectros de potencia para el modelo $\tanh ^4$ variando $\Lambda ^4$ y $M$ bajo la restricción analítica $\displaystyle \lambda = \frac  {\Lambda ^4}{M^4} = 9 \times 10^{-14}$. El incremento en la escala de energía $\Lambda ^4$ induce un aumento simultáneo tanto en la amplitud del espectro como en la frecuencia de los picos resonantes.}}{59}{figure.caption.26}\protected@file@percent }
\newlabel{fig:var_tanh4}{{4.11}{59}{Espectros de potencia para el modelo $\tanh ^4$ variando $\Lambda ^4$ y $M$ bajo la restricción analítica $\displaystyle \lambda = \frac {\Lambda ^4}{M^4} = 9 \times 10^{-14}$. El incremento en la escala de energía $\Lambda ^4$ induce un aumento simultáneo tanto en la amplitud del espectro como en la frecuencia de los picos resonantes}{figure.caption.26}{}}
