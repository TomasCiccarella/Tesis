\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces Comparación de la dinámica del campo para los regímenes de \textit  {Narrow Resonance} y \textit  {Broad Resonance} en el modelo $V(\phi ) = \frac  {1}{2} m^2 \phi ^2$. Se evidencia que la resonancia ancha se caracteriza por la amplificación no adiabática periódica, generando saltos discretos (\textit  {bursts}) tanto en la envolvente del campo como en la densidad espectral de partículas.}}{35}{figure.caption.11}\protected@file@percent }
\newlabel{fig:m2phi2_Resonance}{{3.4}{35}{Comparación de la dinámica del campo para los regímenes de \textit {Narrow Resonance} y \textit {Broad Resonance} en el modelo $V(\phi ) = \frac {1}{2} m^2 \phi ^2$. Se evidencia que la resonancia ancha se caracteriza por la amplificación no adiabática periódica, generando saltos discretos (\textit {bursts}) tanto en la envolvente del campo como en la densidad espectral de partículas}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces Comparación de los regímenes de resonancia en el modelo cuártico $V(\phi ) = \frac  {1}{4} \lambda \phi ^4$. Al igual que en el caso cuadrático, el acoplamiento fuerte induce excitaciones discontinuas de partículas coincidentes con los cruces por cero del campo de fondo.}}{35}{figure.caption.12}\protected@file@percent }
\newlabel{fig:lphi4_Resonance}{{3.5}{35}{Comparación de los regímenes de resonancia en el modelo cuártico $V(\phi ) = \frac {1}{4} \lambda \phi ^4$. Al igual que en el caso cuadrático, el acoplamiento fuerte induce excitaciones discontinuas de partículas coincidentes con los cruces por cero del campo de fondo}{figure.caption.12}{}}
