\newlabel{fig:CosmoLattice_chi_lineal}{{4.1}{18}{Espectro de potencias del campo hijo para distintos valores del parámetro de acoplamiento $q$. Se sombrea en verde la banda de frecuencias que se vé amplificada de acuerdo con el análisis de Floquet y en la misma franja se observa que se encuentra el pico principal del espectro}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Número de partículas que se producen en el campo hijo, además se grafica en verda la banda en la que se espera según el análisis de Floquet que ocurra la banda de producción de partículas.}}{19}{figure.caption.11}\protected@file@percent }
\newlabel{fig:CosmoLattice_nk_lineal}{{4.2}{19}{Número de partículas que se producen en el campo hijo, además se grafica en verda la banda en la que se espera según el análisis de Floquet que ocurra la banda de producción de partículas}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Espectro de potencias de ondas gravitacionales para distintos valores del parámetro de acoplamiento $q$. Se sombrea en verde la banda de frecuencias que se vé amplificada de acuerdo con el análisis de Floquet y en la misma franja se observa que se encuentra el pico principal del espectro, además se observan otros picos consecuencia de la convolución de modos.}}{20}{figure.caption.12}\protected@file@percent }
