\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Tablas de inestabilidad de los coeficientes de Floquet para los distintos modelos. Se muestran en color negro aquellas combinaciones de parámetros tal que el coeficiente no tiene parte real, mientras que se muestra en colores más intensos aquellos dónde la parte real de este coeficiente es mayor; permitiendo observar la estructura de bandas de la resonancia paramétrica.}}{18}{figure.caption.8}\protected@file@percent }
\newlabel{fig:Floquet}{{3.2}{18}{Tablas de inestabilidad de los coeficientes de Floquet para los distintos modelos. Se muestran en color negro aquellas combinaciones de parámetros tal que el coeficiente no tiene parte real, mientras que se muestra en colores más intensos aquellos dónde la parte real de este coeficiente es mayor; permitiendo observar la estructura de bandas de la resonancia paramétrica}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces Bandas de resonancia calculadas a partir de definir un valor fijo para la constante de acoplamiento $(g, q)$ y ver cómo varía el parámetro de Floquet $\mu _k$ con $k$. Se sombrea en naranja la zona dónde se espera la mayor resonancia como consecuencia de un mayor valor para el coeficiente.}}{19}{figure.caption.9}\protected@file@percent }
\newlabel{fig:muk}{{3.3}{19}{Bandas de resonancia calculadas a partir de definir un valor fijo para la constante de acoplamiento $(g, q)$ y ver cómo varía el parámetro de Floquet $\mu _k$ con $k$. Se sombrea en naranja la zona dónde se espera la mayor resonancia como consecuencia de un mayor valor para el coeficiente}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces Comparación entre la dinámica que se dá cuando uno tiene una combinación de parámetros tal que se tiene un tipo de resonancia conocida como \textit  {Narrow Resonance} contra la resonancia conocida como \textit  {Broad Resonance} en un modelo de potencial de tipo $\displaystyle V(\phi ) = \frac  {1}{2} m^2 \phi ^2$. Se puede observar que la \textit  {Broad Resonance} se caracteriza por el aumento espontáneo en la amplitud del campo y como consecuencia también en el número de partículas.}}{20}{figure.caption.10}\protected@file@percent }
\newlabel{fig:m2phi2_Resonance}{{3.4}{20}{Comparación entre la dinámica que se dá cuando uno tiene una combinación de parámetros tal que se tiene un tipo de resonancia conocida como \textit {Narrow Resonance} contra la resonancia conocida como \textit {Broad Resonance} en un modelo de potencial de tipo $\displaystyle V(\phi ) = \frac {1}{2} m^2 \phi ^2$. Se puede observar que la \textit {Broad Resonance} se caracteriza por el aumento espontáneo en la amplitud del campo y como consecuencia también en el número de partículas}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces Comparación entre la dinámica que se dá cuando uno tiene una combinación de parámetros tal que se tiene un tipo de resonancia conocida como \textit  {Narrow Resonance} contra la resonancia conocida como \textit  {Broad Resonance} en un modelo de potencial de tipo $\displaystyle V(\phi ) = \frac  {1}{4} \lambda \phi ^4$. Se puede observar que la \textit  {Broad Resonance} se caracteriza por el aumento espontáneo en la amplitud del campo y como consecuencia también en el número de partículas.}}{20}{figure.caption.11}\protected@file@percent }
\newlabel{fig:lphi4_Resonance}{{3.5}{20}{Comparación entre la dinámica que se dá cuando uno tiene una combinación de parámetros tal que se tiene un tipo de resonancia conocida como \textit {Narrow Resonance} contra la resonancia conocida como \textit {Broad Resonance} en un modelo de potencial de tipo $\displaystyle V(\phi ) = \frac {1}{4} \lambda \phi ^4$. Se puede observar que la \textit {Broad Resonance} se caracteriza por el aumento espontáneo en la amplitud del campo y como consecuencia también en el número de partículas}{figure.caption.11}{}}
