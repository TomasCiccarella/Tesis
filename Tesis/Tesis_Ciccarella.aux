\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Tablas de inestabilidad de Floquet para los modelos estudiados. Las regiones en color negro denotan combinaciones de parámetros asociadas a una evolución estable (exponente puramente imaginario). Los colores intensos resaltan los valores de mayor magnitud para $\Re \{\mu _k\}$, haciendo evidente la estructura de bandas propia de la resonancia paramétrica.}}{33}{figure.caption.9}\protected@file@percent }
\newlabel{fig:Floquet}{{3.2}{33}{Tablas de inestabilidad de Floquet para los modelos estudiados. Las regiones en color negro denotan combinaciones de parámetros asociadas a una evolución estable (exponente puramente imaginario). Los colores intensos resaltan los valores de mayor magnitud para $\Re \{\mu _k\}$, haciendo evidente la estructura de bandas propia de la resonancia paramétrica}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces Dependencia del exponente de Floquet $\mu _k$ respecto al número de onda $k$ para un valor de acoplamiento $q$ fijo. La región sombreada en naranja ilustra la ventana espectral donde domina el crecimiento resonante.}}{34}{figure.caption.10}\protected@file@percent }
\newlabel{fig:muk}{{3.3}{34}{Dependencia del exponente de Floquet $\mu _k$ respecto al número de onda $k$ para un valor de acoplamiento $q$ fijo. La región sombreada en naranja ilustra la ventana espectral donde domina el crecimiento resonante}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces Comparación de la dinámica del campo para los regímenes de \textit  {Narrow Resonance} y \textit  {Broad Resonance} en el modelo $V(\phi ) = \frac  {1}{2} m^2 \phi ^2$. Se observa que la resonancia ancha se caracteriza por la amplificación no adiabática periódica, generando saltos discretos (\textit  {bursts}) tanto en la envolvente del campo como en la densidad espectral de partículas. Se puede notar, además, en las figuras del número de partículas las oscilaciones del inflatón en verde y se observa que cuando este pasa por el cero se producen los \textit  {burst}.}}{35}{figure.caption.11}\protected@file@percent }
\newlabel{fig:m2phi2_Resonance}{{3.4}{35}{Comparación de la dinámica del campo para los regímenes de \textit {Narrow Resonance} y \textit {Broad Resonance} en el modelo $V(\phi ) = \frac {1}{2} m^2 \phi ^2$. Se observa que la resonancia ancha se caracteriza por la amplificación no adiabática periódica, generando saltos discretos (\textit {bursts}) tanto en la envolvente del campo como en la densidad espectral de partículas. Se puede notar, además, en las figuras del número de partículas las oscilaciones del inflatón en verde y se observa que cuando este pasa por el cero se producen los \textit {burst}}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces Comparación de los regímenes de resonancia en el modelo cuártico $V(\phi ) = \frac  {1}{4} \lambda \phi ^4$. Al igual que en el caso cuadrático, el acoplamiento fuerte induce excitaciones discontinuas de partículas coincidentes con los cruces por cero del campo de fondo.}}{36}{figure.caption.12}\protected@file@percent }
\newlabel{fig:lphi4_Resonance}{{3.5}{36}{Comparación de los regímenes de resonancia en el modelo cuártico $V(\phi ) = \frac {1}{4} \lambda \phi ^4$. Al igual que en el caso cuadrático, el acoplamiento fuerte induce excitaciones discontinuas de partículas coincidentes con los cruces por cero del campo de fondo}{figure.caption.12}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3.3}Dinámica con expansión}{36}{section.3.3}\protected@file@percent }
\citation{Amin_2014,Kofman_1997}
\citation{Greene_1997}
