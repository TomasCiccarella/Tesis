\@writefile{lof}{\contentsline {figure}{\numberline {4.5}{\ignorespaces Evolución del factor de escala $a$ para modelos con (a) $\omega _{eff} = 1/3$ y (b) $\omega _{eff} = 0$. Se ilustra con línea continua la evolución numérica completa obtenida con \ensuremath  {\mathcal  {C}}\text  {osmo}\ensuremath  {\mathcal  {L}}\text  {attice}\xspace  , evidenciando una excelente convergencia hacia los comportamientos asintóticos teóricos marcados en línea discontinua.}}{55}{figure.caption.20}\protected@file@percent }
\newlabel{fig:CosmoLattice_background_a}{{4.5}{55}{Evolución del factor de escala $a$ para modelos con (a) $\omega _{eff} = 1/3$ y (b) $\omega _{eff} = 0$. Se ilustra con línea continua la evolución numérica completa obtenida con \CosmoLattice , evidenciando una excelente convergencia hacia los comportamientos asintóticos teóricos marcados en línea discontinua}{figure.caption.20}{}}
\citation{Dufaux_2007,Figueroa_2017_GW}
\@writefile{lof}{\contentsline {figure}{\numberline {4.6}{\ignorespaces Evolución dinámica del inflatón $\phi $ para modelos con (a) $\omega _{eff} = 1/3$ y (b) $\omega _{eff} = 0$. Se evidencia que los potenciales monomiales inducen un decaimiento más rápido de la amplitud del campo \textit  {background} en comparación con los modelos de tipo \textit  {plateau}.}}{56}{figure.caption.21}\protected@file@percent }
\newlabel{fig:CosmoLattice_background_phi}{{4.6}{56}{Evolución dinámica del inflatón $\phi $ para modelos con (a) $\omega _{eff} = 1/3$ y (b) $\omega _{eff} = 0$. Se evidencia que los potenciales monomiales inducen un decaimiento más rápido de la amplitud del campo \textit {background} en comparación con los modelos de tipo \textit {plateau}}{figure.caption.21}{}}
