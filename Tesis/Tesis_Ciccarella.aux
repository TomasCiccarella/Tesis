\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces CORREGIR: HABLAR CON NAHUE - SEGURO VALE LA PENA MOSTRAR PERO SACANDO GRAFICOS}}{10}{figure.caption.6}\protected@file@percent }
\newlabel{fig:muk}{{3.3}{10}{CORREGIR: HABLAR CON NAHUE - SEGURO VALE LA PENA MOSTRAR PERO SACANDO GRAFICOS}{figure.caption.6}{}}
\citation{CosmoLatticeNet,Figueroa2021,Figueroa2023,Figueroa2024,Figueroa_2017_GW,Figueroa_2017_Parametric}
\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces Comparación entre la dinámica que se dá cuando uno tiene una combinación de parámetros tal que se tiene un tipo de resonancia conocida como \textit  {Narrow Resonance} contra la resonancia conocida como \textit  {Broad Resonance} en un modelo de potencial de tipo $\displaystyle V(\phi ) = \frac  {1}{2} m^2 \phi ^2$. Se puede observar que la \textit  {Broad Resonance} se caracteriza por el aumento espontáneo en la amplitud del campo y como consecuencia también en el número de partículas.}}{11}{figure.caption.7}\protected@file@percent }
\newlabel{fig:m2phi2_Resonance}{{3.4}{11}{Comparación entre la dinámica que se dá cuando uno tiene una combinación de parámetros tal que se tiene un tipo de resonancia conocida como \textit {Narrow Resonance} contra la resonancia conocida como \textit {Broad Resonance} en un modelo de potencial de tipo $\displaystyle V(\phi ) = \frac {1}{2} m^2 \phi ^2$. Se puede observar que la \textit {Broad Resonance} se caracteriza por el aumento espontáneo en la amplitud del campo y como consecuencia también en el número de partículas}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces Comparación entre la dinámica que se dá cuando uno tiene una combinación de parámetros tal que se tiene un tipo de resonancia conocida como \textit  {Narrow Resonance} contra la resonancia conocida como \textit  {Broad Resonance} en un modelo de potencial de tipo $\displaystyle V(\phi ) = \frac  {1}{4} \lambda \phi ^4$. Se puede observar que la \textit  {Broad Resonance} se caracteriza por el aumento espontáneo en la amplitud del campo y como consecuencia también en el número de partículas.}}{12}{figure.caption.8}\protected@file@percent }
\newlabel{fig:lphi4_Resonance}{{3.5}{12}{Comparación entre la dinámica que se dá cuando uno tiene una combinación de parámetros tal que se tiene un tipo de resonancia conocida como \textit {Narrow Resonance} contra la resonancia conocida como \textit {Broad Resonance} en un modelo de potencial de tipo $\displaystyle V(\phi ) = \frac {1}{4} \lambda \phi ^4$. Se puede observar que la \textit {Broad Resonance} se caracteriza por el aumento espontáneo en la amplitud del campo y como consecuencia también en el número de partículas}{figure.caption.8}{}}
