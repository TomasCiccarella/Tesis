\@writefile{lof}{\contentsline {figure}{\numberline {4.15}{\ignorespaces Espectro de ondas gravitacionales para el modelo $m^2 \phi ^2$ variando el parámetro de acoplamiento $q$. Se ilustra la transición hacia el régimen de resonancia ancha para $q \gtrsim 7280$, umbral a partir del cual el espectro adquiere amplitudes macroscópicas y picos bien definidos.}}{54}{figure.caption.28}\protected@file@percent }
\newlabel{fig:Omega_varq_m2phi2}{{4.15}{54}{Espectro de ondas gravitacionales para el modelo $m^2 \phi ^2$ variando el parámetro de acoplamiento $q$. Se ilustra la transición hacia el régimen de resonancia ancha para $q \gtrsim 7280$, umbral a partir del cual el espectro adquiere amplitudes macroscópicas y picos bien definidos}{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.16}{\ignorespaces Evolución de la densidad de energía gravitacional para distintos valores de $q$ en el modelo monomial. A bajos acoplamientos, la inyección de energía es exigua, requiriendo un $q$ elevado para desatar una cascada resonante eficiente.}}{55}{figure.caption.29}\protected@file@percent }
\newlabel{fig:energy_varq_m2phi2}{{4.16}{55}{Evolución de la densidad de energía gravitacional para distintos valores de $q$ en el modelo monomial. A bajos acoplamientos, la inyección de energía es exigua, requiriendo un $q$ elevado para desatar una cascada resonante eficiente}{figure.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.17}{\ignorespaces Espectro de potencias para el modelo $m^2 \phi ^2$ ante variaciones de la masa $m$. Masas muy elevadas suprimen la amplitud espectral por un decaimiento prematuro del condensado, mientras que valores extremos introducen amortiguamientos espurios debidos a la discretización numérica.}}{56}{figure.caption.30}\protected@file@percent }
\newlabel{fig:Omega_varm_m2phi2}{{4.17}{56}{Espectro de potencias para el modelo $m^2 \phi ^2$ ante variaciones de la masa $m$. Masas muy elevadas suprimen la amplitud espectral por un decaimiento prematuro del condensado, mientras que valores extremos introducen amortiguamientos espurios debidos a la discretización numérica}{figure.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.18}{\ignorespaces Evolución energética para distintas masas en $m^2 \phi ^2$. El primer panel revela la ruptura total del código algorítmico frente a frecuencias excesivamente altas, evidenciando una divergencia violenta típica de inestabilidades de red discretas.}}{56}{figure.caption.31}\protected@file@percent }
\newlabel{fig:energy_varm_m2phi2}{{4.18}{56}{Evolución energética para distintas masas en $m^2 \phi ^2$. El primer panel revela la ruptura total del código algorítmico frente a frecuencias excesivamente altas, evidenciando una divergencia violenta típica de inestabilidades de red discretas}{figure.caption.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.19}{\ignorespaces Espectro de ondas gravitacionales evaluado para distintos anchos de la meseta (parametrizados por $M$) conservando la masa efectiva $m$ constante. Mayores valores de $M$ trasladan la potencia hacia modos ultravioletas pero deprimen la señal estocástica total.}}{57}{figure.caption.32}\protected@file@percent }
\newlabel{fig:Omega_varM}{{4.19}{57}{Espectro de ondas gravitacionales evaluado para distintos anchos de la meseta (parametrizados por $M$) conservando la masa efectiva $m$ constante. Mayores valores de $M$ trasladan la potencia hacia modos ultravioletas pero deprimen la señal estocástica total}{figure.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.20}{\ignorespaces Evolución energética frente a la variación de $M$. Se destaca el colapso numérico inminente para los valores más altos de $M$, donde se incurre en una violación franca de las condiciones dinámicas de Friedmann ($\langle \rho \rangle a^3 > 1$).}}{58}{figure.caption.33}\protected@file@percent }
\newlabel{fig:energy_varM}{{4.20}{58}{Evolución energética frente a la variación de $M$. Se destaca el colapso numérico inminente para los valores más altos de $M$, donde se incurre en una violación franca de las condiciones dinámicas de Friedmann ($\langle \rho \rangle a^3 > 1$)}{figure.caption.33}{}}
