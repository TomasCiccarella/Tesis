#Output
outputfile = ./data/

#Evolution
expansion = true
evolver = VV2

#Lattice
N = 32
dt = 5e-5
kIR = 0.2

#Times
tOutputFreq = 1
tOutputInfreq = 1
tMax = 200
baseSeed = 4356597

#Spectra options
PS_type = 1
PS_version = 1

#GWs
GWprojectorType = 1
withGWs = true

#IC
kCutOff = 4
initial_amplitudes = 5.6964e18 0  # homogeneous amplitudes in GeV
initial_momenta = -4.86735e30 0   # homogeneous amplitudes in GeV2

#Model Parameters
m = 1e-6 
q = 1e6
